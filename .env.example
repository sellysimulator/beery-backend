# Application
DEBUG=false
HOST=0.0.0.0
PORT=8080

# Must never be ["*"]: the app sets allow_credentials=True.
CORS_ORIGINS=["http://localhost:5173"]

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=beery
DB_REQUIRE_SSL=false
DB_SSL_CA=

# Redis — optional. Live room state (lobbies, seating, the running game) is
# held in a key-value store; this switch chooses which one.
#   false (default) — state lives in a dict inside this process. No Redis is
#     needed to run the app. Valid only for a SINGLE instance with no
#     `--workers`: two processes means two players in one room never see each
#     other. A restart ends every game in progress.
#   true — state lives in Redis and Socket.IO fans out through it, so more
#     than one instance works and a restart does not lose live rooms.
#     REDIS_URL is then required; an empty one refuses to start.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Firebase service account JSON, on a single line.
# Use single quotes or no quotes — with double quotes python-dotenv decodes the
# \n inside private_key into real newlines and then fails to parse the line,
# leaving the variable silently unset.
FIREBASE_SERVICE_ACCOUNT_JSON=
