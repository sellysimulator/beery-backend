# Application
DEBUG=false
HOST=0.0.0.0
PORT=8080

# Must never be ["*"]: the app sets allow_credentials=True.
CORS_ORIGINS=["http://localhost:5173"]

# Database — PostgreSQL 18. Production: the database `beerydb` on Beery's own
# Neon project (user `neondb_owner`, port 5432; DB_HOST is the DIRECT endpoint
# `ep-….us-east-1.aws.neon.tech`, without `-pooler`: the pooled endpoint
# rejects the `options=-c timezone=UTC` startup parameter). Everyday local
# development uses a local Docker PostgreSQL 18, never Neon (a local backend
# against Neon is one more instance and breaks the connection budget during a
# deploy, DEPLOY.md):
# `docker run --rm -e POSTGRES_PASSWORD=… -e POSTGRES_DB=beerydb -p 127.0.0.1:5432:5432 postgres:18`
# with DB_REQUIRE_SSL=false and DB_SSL_CA empty.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=beerydb
# TLS is required by default (sslmode=require); false only for a local
# Postgres without TLS. DB_SSL_CA is the CA bundle Neon's certificates chain
# to: the Let's Encrypt roots ISRG Root X1 + ISRG Root X2 in one PEM file (the
# same public file for all four games; locally
# <Novus>/novus-secrets/neon-ca.pem) and turns on
# sslmode=verify-full: certificate and hostname verification (DB_HOST must then
# be the hostname, not an IP). Either the PEM text -- ONE line, UNQUOTED, \n
# between the PEM lines, as printed by `awk '{printf "%s\\n", $0}' ca.pem` --
# or a path to a PEM file. Not a secret. A value that is neither stops the app
# at boot.
DB_REQUIRE_SSL=true
DB_SSL_CA=
# Connection pool per process (pool size + overflow), at most 7 + 2 = 9: Beery's
# budget is 20 connections, deploys included (two overlapping instances, the
# startup migration and one psql session; DEPLOY.md, "Managed PostgreSQL version").
# DB_POOL_SIZE=7
# DB_MAX_OVERFLOW=2

# Redis — optional. Live room state (lobbies, seating, the running game) is
# held in a key-value store; this switch chooses which one.
#   false (default) — state lives in a dict inside this process. No Redis is
#     needed to run the app. Valid only for a SINGLE instance with no
#     `--workers`: two processes means two players in one room never see each
#     other. A restart ends every game in progress.
#   true — state lives in Redis and Socket.IO fans out through it, so more
#     than one instance works and a restart does not lose live rooms.
#     REDIS_URL is then required; an empty one refuses to start.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Firebase service account JSON, on a single line.
# Use single quotes or no quotes — with double quotes python-dotenv decodes the
# \n inside private_key into real newlines and then fails to parse the line,
# leaving the variable silently unset.
FIREBASE_SERVICE_ACCOUNT_JSON=
